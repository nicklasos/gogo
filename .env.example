# Database Configuration
DATABASE_URL=postgres://postgres@localhost:5432/gogo?sslmode=disable

# Test Database (for running tests with real database)
TEST_DATABASE_URL=postgres://postgres@localhost:5432/gogo_test?sslmode=disable

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Server Configuration
PORT=8181
APP_URL=localhost:8181

# Application Environment
APP_ENV=development
# Also used as the Redis cache key prefix
APP_NAME=MyApp
APP_DEBUG=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=text
LOG_OUTPUT=both # Options: stdout, stderr, both, or file path like "logs/app.log"

# CORS: comma-separated origins. Empty or * allows any origin (fine for local development)
CORS_ALLOWED_ORIGINS=

# JWT secret (required). With APP_ENV=production the API refuses to start on this placeholder
# or on anything shorter than 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TOKEN_TTL=1h
JWT_REFRESH_TOKEN_TTL=720h

# Auth
# Open POST /auth/register to anyone. Off by default: accounts are created by admins.
ALLOW_REGISTRATION=false
# Throttle login, refresh and the emailed-link endpoints
AUTH_RATE_LIMIT=true
# Base URL of the links in password reset and email verification mails
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TTL=1h
EMAIL_VERIFICATION_TTL=48h
# Proxies whose X-Forwarded-For is trusted for the client IP (comma-separated)
TRUSTED_PROXIES=127.0.0.1,::1

# Uploads
UPLOAD_FOLDER=./uploads
FILES_BASE_URL=http://localhost:8181/api/files

# Monitoring dashboard (gopulse) at PULSE_PATH: requests, errors, SQL queries, logs, server.
# It is off until PULSE_PASSWORD is set. History is kept in Redis.
PULSE_USERNAME=admin
PULSE_PASSWORD=
PULSE_PATH=/_pulse

# Mail (SMTP). With APP_DEBUG=true mail is logged instead of sent.
# MAIL_SCHEME: smtp (STARTTLS), smtps (implicit TLS) or none (plain, local catchers such as Mailpit)
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="MyApp"

# Scheduler (run cron jobs inside the API process)
ENABLE_SCHEDULER=false
